<!--
    Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html

    # "add-to-group" ids

    https://plugins.jetbrains.com/docs/intellij/basic-action-system.html#action-declaration-reference
    https://upsource.jetbrains.com/~download?code=qYz1c84O&state=%2F%7Edownload.inline%2Fidea-ce%3Aidea-ce-679130dc0a5ed633b39e32864cca07b47a524690%3A%2Fplatform%2Fplatform-resources%2Fsrc%2Fidea%2FPlatformActions.xml
    https://intellij-support.jetbrains.com/hc/en-us/community/posts/206761495-How-to-add-items-to-a-tab-context-menu-

    # Dependencies definition

    https://plugins.jetbrains.com/docs/intellij/plugin-dependencies.html
-->

<idea-plugin>
    <id>com.github.intellij.plugins.mt4ij</id>
    <name>Maven Templating assistant</name>
    <vendor>Antonio Petricca</vendor>

    <resource-bundle>messages.Bundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <depends>com.intellij.modules.jcef</depends>

    <actions>
        <action
            class="com.github.intellij.plugins.mt4ij.actions.ProjectScannerAction"
            id="mt4ij.actions.project-scanner"
            icon="AllIcons.Actions.Refresh"
        />

        <action
            class="com.github.intellij.plugins.mt4ij.actions.OpenGuideAction"
            id="mt4ij.actions.open-guide"
            icon="AllIcons.Actions.Help"
        />

        <action
            class="com.github.intellij.plugins.mt4ij.actions.OpenGuideAction"
            id="mt4ij.actions.open-guide.help"
            icon="AllIcons.Actions.Help"
        >
            <add-to-group group-id="HelpMenu" anchor="after" relative-to-action="HelpTopics"/>
        </action>

        <action
            class="com.github.intellij.plugins.mt4ij.actions.OpenWhatsNewAction"
            id="mt4ij.actions.whats-new"
            icon="AllIcons.General.Information"
        />

        <action
            class="com.github.intellij.plugins.mt4ij.navigation.GoToCounterpartAction"
            id="mt4ij.actions.go-to-counterpart"
            icon="com.github.intellij.plugins.mt4ij.MavenTemplatingIcons.GoToGenerated"
        >
            <!-- No letter is left free with Ctrl+Alt+Shift (G is Database Tools, Y is Code With Me), so Space it is -->
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift SPACE"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift G"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift G"/>
        </action>

        <!-- Same jump for the Navigate and Go To menus, where it is hidden when it does not apply -->
        <action
            class="com.github.intellij.plugins.mt4ij.navigation.GoToCounterpartNavigateAction"
            id="mt4ij.actions.go-to-counterpart.navigate"
            icon="com.github.intellij.plugins.mt4ij.MavenTemplatingIcons.GoToGenerated"
        >
            <add-to-group group-id="GoToCodeGroup" anchor="after" relative-to-action="GotoRelated"/>
            <add-to-group group-id="EditorPopupMenu.GoTo" anchor="after" relative-to-action="GotoRelated"/>
        </action>

        <group
            id="mt4ij.groups.main"
            class="com.github.intellij.plugins.mt4ij.actions.MavenTemplatingGroup"
            popup="true"
            icon="com.github.intellij.plugins.mt4ij.MavenTemplatingIcons.Plugin"
        >
            <reference ref="mt4ij.actions.go-to-counterpart"/>
            <reference ref="mt4ij.actions.project-scanner"/>
            <separator/>
            <reference ref="mt4ij.actions.open-guide"/>
            <reference ref="mt4ij.actions.whats-new"/>

            <add-to-group group-id="EditorPopupMenu1" anchor="after" relative-to-action="EditorPopupMenu1.FindRefactor"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="ProjectViewEditSource"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="CopyPaths"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.intellij.plugins.mt4ij.activities.ProjectStartupActivity" />
        <postStartupActivity implementation="com.github.intellij.plugins.mt4ij.activities.WhatsNewStartupActivity" />

        <notificationGroup
            id="mt4ij.notifications"
            displayType="BALLOON"
            key="mt4ij.notification.group.name"
            bundle="messages.Bundle"
        />

        <codeInsight.lineMarkerProvider
            language="JAVA"
            implementationClass="com.github.intellij.plugins.mt4ij.navigation.TemplateLineMarkerProvider"
        />

        <editorFactoryListener implementation="com.github.intellij.plugins.mt4ij.navigation.GeneratedSourceGutterIcon" />

        <editorNotificationProvider
            implementation="com.github.intellij.plugins.mt4ij.navigation.CounterpartBannerProvider"
        />

        <psi.referenceContributor
            language="JAVA"
            implementation="com.github.intellij.plugins.mt4ij.properties.MavenPropertyReferenceContributor"
        />

        <localInspection
            language="JAVA"
            shortName="UnresolvedMavenProperty"
            bundle="messages.Bundle"
            key="mt4ij.inspection.unresolved-property.name"
            groupBundle="messages.Bundle"
            groupKey="mt4ij.inspection.group"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.github.intellij.plugins.mt4ij.properties.UnresolvedMavenPropertyInspection"
        />

        <projectConfigurable
            instance="com.github.intellij.plugins.mt4ij.config.SettingsConfigurable"
            key="mt4ij.settings.name"
            bundle="messages.Bundle"
            groupId="build.tools"
            id="mt4ij.settings"
        />
    </extensions>

    <projectListeners>
        <listener
            class="com.github.intellij.plugins.mt4ij.listeners.VFSListener"
            topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"
        />
        <listener
            class="com.github.intellij.plugins.mt4ij.navigation.GutterIconImportListener"
            topic="org.jetbrains.idea.maven.project.MavenImportListener"
        />
        <listener
            class="com.github.intellij.plugins.mt4ij.navigation.GutterIconSelectionListener"
            topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"
        />
    </projectListeners>

    <extensions defaultExtensionNs="org.jetbrains.idea.maven">
        <importing.workspaceConfigurator implementation="com.github.intellij.plugins.mt4ij.importing.TemplatingFoldersConfigurator" />
    </extensions>
</idea-plugin>
