    Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html

    # "add-to-group" ids

    https://plugins.jetbrains.com/docs/intellij/basic-action-system.html#action-declaration-reference
    https://upsource.jetbrains.com/~download?code=qYz1c84O&state=%2F%7Edownload.inline%2Fidea-ce%3Aidea-ce-679130dc0a5ed633b39e32864cca07b47a524690%3A%2Fplatform%2Fplatform-resources%2Fsrc%2Fidea%2FPlatformActions.xml
    https://intellij-support.jetbrains.com/hc/en-us/community/posts/206761495-How-to-add-items-to-a-tab-context-menu-

    # Dependencies definition

    https://plugins.jetbrains.com/docs/intellij/plugin-dependencies.html
-->

<idea-plugin>
    <id>com.github.intellij.plugins.mt4ij</id>
    <name>Maven Templating assistant</name>
    <vendor>Antonio Petricca</vendor>

    <resource-bundle>messages.Bundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.xml</depends>

    <actions>
        <action
            class="com.github.intellij.plugins.mt4ij.actions.ProjectScannerAction"
            id="mt4ij.actions.project-scanner"
        >
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
            class="com.github.intellij.plugins.mt4ij.navigation.GoToCounterpartAction"
            id="mt4ij.actions.go-to-counterpart"
        >
            <add-to-group group-id="GoToMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.intellij.plugins.mt4ij.activities.ProjectStartupActivity" />

        <notificationGroup
            id="mt4ij.notifications"
            displayType="BALLOON"
            key="mt4ij.notification.group.name"
            bundle="messages.Bundle"
        />

        <codeInsight.lineMarkerProvider
            language="JAVA"
            implementationClass="com.github.intellij.plugins.mt4ij.navigation.TemplateLineMarkerProvider"
        />

        <psi.referenceContributor
            language="JAVA"
            implementation="com.github.intellij.plugins.mt4ij.properties.MavenPropertyReferenceContributor"
        />

        <localInspection
            language="JAVA"
            shortName="UnresolvedMavenProperty"
            bundle="messages.Bundle"
            key="mt4ij.inspection.unresolved-property.name"
            groupBundle="messages.Bundle"
            groupKey="mt4ij.inspection.group"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.github.intellij.plugins.mt4ij.properties.UnresolvedMavenPropertyInspection"
        />

        <projectConfigurable
            instance="com.github.intellij.plugins.mt4ij.config.SettingsConfigurable"
            key="mt4ij.settings.name"
            bundle="messages.Bundle"
            groupId="build.tools"
            id="mt4ij.settings"
        />
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.idea.maven">
        <importing.workspaceConfigurator implementation="com.github.intellij.plugins.mt4ij.importing.TemplatingFoldersConfigurator" />
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode mode="ANY"/>
    </extensions>
</idea-plugin>
